# Copie este arquivo para .env e troque as senhas antes de iniciar o banco.
SQL_MENTOR_POSTGRES_DB=sql_mentor
SQL_MENTOR_POSTGRES_USER=mentor_admin
SQL_MENTOR_POSTGRES_PASSWORD=change-me-admin
SQL_MENTOR_SANDBOX_PASSWORD=change-me-sandbox
SQL_MENTOR_POSTGRES_HOST=127.0.0.1
SQL_MENTOR_POSTGRES_PORT=5432
SQL_MENTOR_SANDBOX_TIMEOUT_MS=1000
SQL_MENTOR_SANDBOX_MAX_ROWS=100
SQL_MENTOR_PROBE_MAX_QUESTIONS=8
SQL_MENTOR_TARGET_DIFFICULTY=medium

# B11 — LLM Adapter. Substitua a chave somente no .env local; nunca versione o valor real.
LLM_PROVIDER=openai
# Opcional: endpoint OpenAI-compatible (ex.: OmniRouter http://localhost:20128/v1)
# LLM_BASE_URL=https://api.openai.com/v1
# Para OmniRouter local, use LLM_PROVIDER=omnirouter e
# LLM_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini
# Para OpenRouter, use LLM_PROVIDER=openrouter e OPENROUTER_API_KEY; mantenha
# OPENAI_MODEL em um modelo que suporte Structured Outputs.
# OPENROUTER_API_KEY=replace-me
LLM_POLICY_VERSION=tutor-policy-v0.1
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0
# LLM_TOP_P e opcional (0..1). Evite ajustar junto com temperature sem necessidade.
# LLM_TOP_P=1
